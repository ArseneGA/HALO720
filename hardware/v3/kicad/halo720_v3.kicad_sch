  (text "NOTES DE CONCEPTION" (at 345.44 248.92 0) (effects (font (size 2.0 2.0) bold) (justify left bottom)) (uuid fcf48567-f9c9-5f0b-aff2-4f1c2945526d))
  (text "- CM4 Wi-Fi 1 Go eMMC 16 Go (CM4101016), fourni et clipsé par l'usine. Wi-Fi 2,4 / 5 GHz : point d'accès en 5 GHz." (at 345.44 254 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid 45275823-9a01-5855-9e7d-9537d9daceda))
  (text "- Conso CM4 : ~0,4 A au repos, jusqu'à 1,4 A (datasheet). IP5306 : 5 V / 2,4 A max." (at 345.44 259.08 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid fe2f41d2-467c-518e-8601-eddbcaff828c))
  (text "- Pic batterie (CM4 + flash) : ~2,6 A + ~1,8 A. LiPo 1S >= 2000 mAh avec protection (PCM) >= 5 A." (at 345.44 264.16 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid 028d0fb9-984d-5242-b0ed-d7b3b7f15160))
  (text "- Charge IP5306 jusqu'à 2,1 A par défaut : la réduire en I2C au démarrage, LiPo acceptant >= 1C." (at 345.44 269.24 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid a755ebfc-d274-5acd-abf1-b7d57c2e1756))
  (text "- USB-C branché : l'IP5306 alimente aussi le 5 V, l'appareil reste allumé pendant la charge." (at 345.44 274.32 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid af1c9197-9d3c-55d6-8d59-a65142f0207c))
  (text "- Logiciel : dtoverlay=imx708 (CAM1), dtoverlay=dwc2,dr_mode=peripheral (USB gadget)." (at 345.44 279.4 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid 90d908b2-3311-5ff5-947d-74e47d96cef5))
  (text "- GPIO libres : 4-13, 16, 18-21, 24-26." (at 345.44 284.48 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid 5bec9d12-2945-5345-9f19-f98139e9e211))
  (text "- Empreintes DF40HC : pastilles de l'empreinte officielle CM4IO (Raspberry Pi), motif Hirose 0,2 x 0,7 mm." (at 345.44 289.56 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid a16e6339-1ab7-5a2e-aa85-da87cc468207))
  (text "- Usine : CM4 clipsé, eMMC programmée, caméra et carte flash branchées, test. Batterie branchée par l'utilisateur." (at 345.44 294.64 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid 20886714-09ba-561c-9d82-15de7ba11744))

  (sheet_instances
    (path "/" (page "1"))
  )
